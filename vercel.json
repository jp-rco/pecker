{
  "version": 2,
  "buildCommand": "chmod +x node_modules/.bin/vite node_modules/.bin/esbuild && npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/analyze",
      "dest": "/api/analyze.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
